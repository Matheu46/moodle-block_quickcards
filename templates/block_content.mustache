{{!
    @template block_quickcards/block_content

    QuickCards block overview and review status.

    Classes required for JS:
    * none

    Context variables required for this template:
    * iscourse: bool
    * hasdue: bool
    * totaldue: int
    * totalcards: int
    * hasdecks: bool
    * decks: array
    * mainurl: string
    * hasanydecks: bool
}}
<div class="block-quickcards-content">
    {{#hasdue}}
    <div class="alert alert-warning d-flex align-items-center p-2 mb-3" role="alert">
        <i class="fa fa-bell me-2" aria-hidden="true"></i>
        <div>
            <strong>{{#str}} duereviews, block_quickcards {{/str}}:</strong>
            <span class="badge bg-danger ms-1">{{totaldue}}</span>
        </div>
    </div>
    {{/hasdue}}
    {{^hasdue}}
    <div class="alert alert-success d-flex align-items-center p-2 mb-3" role="status">
        <i class="fa fa-check-circle me-2" aria-hidden="true"></i>
        <div>
            <small>{{#str}} alldone, block_quickcards {{/str}}</small>
        </div>
    </div>
    {{/hasdue}}

    {{#hasdecks}}
    <div class="quickcards-deck-list list-group list-group-flush mb-2">
        {{#decks}}
        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
            <div class="me-2 text-truncate">
                <a href="{{deckurl}}" class="fw-bold text-decoration-none text-truncate d-block" title="{{name}}">
                    {{name}}
                </a>
                <small class="text-muted">
                    {{totalcards}} {{#str}} totalcardsstat, block_quickcards {{/str}}
                    {{#hasdue}}
                    &bull; <span class="text-danger fw-bold">{{duecount}} {{#str}} duecardsstat, block_quickcards {{/str}}</span>
                    {{/hasdue}}
                </small>
            </div>
            <div>
                {{#hasdue}}
                <a href="{{studyurl}}" class="btn btn-sm btn-primary" title="{{#str}} studydeck, block_quickcards, {{name}} {{/str}}">
                    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
                    <span class="d-none d-sm-inline">{{#str}} study, block_quickcards {{/str}}</span>
                </a>
                {{/hasdue}}
                {{^hasdue}}
                <a href="{{deckurl}}" class="btn btn-sm btn-outline-secondary" title="{{name}}">
                    <i class="fa fa-folder-open-o" aria-hidden="true"></i>
                </a>
                {{/hasdue}}
            </div>
        </div>
        {{/decks}}
    </div>
    {{/hasdecks}}

    {{^hasdecks}}
    <div class="text-center py-3 text-muted">
        <i class="fa fa-clone fa-2x mb-2 d-block" aria-hidden="true"></i>
        <p class="mb-2"><small>{{#str}} nodecks, block_quickcards {{/str}}</small></p>
        <a href="{{mainurl}}" class="btn btn-sm btn-outline-primary">
            <i class="fa fa-plus" aria-hidden="true"></i> {{#str}} createdeck, block_quickcards {{/str}}
        </a>
    </div>
    {{/hasdecks}}
</div>
