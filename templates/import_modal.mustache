{{!
    @template block_quickcards/import_modal

    Modal dialog for importing a QuickCards deck or cards from JSON or CSV/Anki/Quizlet.

    Example context (json):
    {
        "config": {
            "wwwroot": "https://example.com"
        },
        "sesskey": "sesskey123",
        "hascourses": true,
        "courses": [
            {
                "id": 2,
                "fullname": "Web Development"
            }
        ],
        "hasuserdecks": true,
        "userdecks": [
            {
                "id": 1,
                "name": "JavaScript Fundamentals"
            }
        ]
    }
}}
<div class="modal fade" id="quickcards-import-modal" tabindex="-1" aria-labelledby="quickcards-import-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickcards-import-modal-title">
                    <i class="fa fa-upload me-2 text-primary" aria-hidden="true"></i><span id="quickcards-import-modal-title-text">{{#str}} importdeck, block_quickcards {{/str}}</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} close, block_quickcards {{/str}}"></button>
            </div>

            <!-- Format Tabs -->
            <ul class="nav nav-tabs px-3 pt-2 bg-light" id="quickcards-import-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="quickcards-tab-json-btn" data-bs-toggle="tab" data-bs-target="#quickcards-import-tab-json" type="button" role="tab" aria-controls="quickcards-import-tab-json" aria-selected="true">
                        <i class="fa fa-file-code-o me-1" aria-hidden="true"></i>{{#str}} importtabjson, block_quickcards {{/str}}
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="quickcards-tab-csv-btn" data-bs-toggle="tab" data-bs-target="#quickcards-import-tab-csv" type="button" role="tab" aria-controls="quickcards-import-tab-csv" aria-selected="false">
                        <i class="fa fa-table me-1" aria-hidden="true"></i>{{#str}} importtabcsv, block_quickcards {{/str}}
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="quickcards-import-tab-content">
                <!-- Tab 1: JSON Import -->
                <div class="tab-pane fade show active" id="quickcards-import-tab-json" role="tabpanel" aria-labelledby="quickcards-tab-json-btn">
                    <form id="quickcards-import-form">
                        <div class="modal-body">
                            <!-- Locked target banner (when importing directly into a deck) -->
                            <div class="alert alert-info py-2 px-3 mb-3 d-none quickcards-import-target-banner" role="status">
                                <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                                <span class="quickcards-import-target-name"></span>
                            </div>

                            <!-- Destination choice (when opened globally) -->
                            {{#hasuserdecks}}
                            <div class="mb-3 quickcards-import-dest-choice" id="quickcards-import-json-dest-choice">
                                <label class="form-label fw-bold">{{#str}} importdestination, block_quickcards {{/str}}</label>
                                <div class="d-flex gap-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-json-dest" id="quickcards-import-json-dest-new" value="new" checked>
                                        <label class="form-check-label" for="quickcards-import-json-dest-new">{{#str}} importnewdeck, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-json-dest" id="quickcards-import-json-dest-existing" value="existing">
                                        <label class="form-check-label" for="quickcards-import-json-dest-existing">{{#str}} importexistingdeck, block_quickcards {{/str}}</label>
                                    </div>
                                </div>
                                <div class="quickcards-import-existing-select-wrap d-none" id="quickcards-import-json-existing-select-wrap">
                                    <select class="form-select form-select-sm" id="quickcards-import-json-deck-select">
                                        <option value="0">{{#str}} selecttargetdeck, block_quickcards {{/str}}</option>
                                        {{#userdecks}}
                                            <option value="{{id}}">{{name}}</option>
                                        {{/userdecks}}
                                    </select>
                                </div>
                            </div>
                            {{/hasuserdecks}}

                            <!-- Duplicate options (for existing deck) -->
                            <div class="p-2 border rounded bg-light mb-3 d-none quickcards-import-duplicate-wrap" id="quickcards-import-json-duplicate-wrap">
                                <label class="form-label small fw-bold mb-1">
                                    <i class="fa fa-clone text-secondary me-1" aria-hidden="true"></i>{{#str}} duplicateaction, block_quickcards {{/str}}
                                </label>
                                <div class="form-text small text-muted mb-2">{{#str}} duplicateaction_help, block_quickcards {{/str}}</div>
                                <div class="d-flex flex-column gap-1 small">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-json-dup" id="quickcards-import-json-dup-skip" value="skip" checked>
                                        <label class="form-check-label" for="quickcards-import-json-dup-skip">{{#str}} duplicateskip, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-json-dup" id="quickcards-import-json-dup-update" value="update">
                                        <label class="form-check-label" for="quickcards-import-json-dup-update">{{#str}} duplicateupdate, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-json-dup" id="quickcards-import-json-dup-allow" value="allow">
                                        <label class="form-check-label" for="quickcards-import-json-dup-allow">{{#str}} duplicateallow, block_quickcards {{/str}}</label>
                                    </div>
                                </div>
                            </div>

                            <!-- File input -->
                            <div class="mb-3">
                                <label for="quickcards-import-file-input" class="form-label fw-bold">
                                    {{#str}} selectjsonfile, block_quickcards {{/str}} <span class="text-danger">*</span>
                                </label>
                                <input type="file" id="quickcards-import-file-input" class="form-control" accept=".json,application/json" required>
                                <div class="form-text text-muted">{{#str}} selectjsonfile_help, block_quickcards {{/str}}</div>
                            </div>

                            <!-- Error Alert -->
                            <div id="quickcards-import-error" class="alert alert-danger d-none py-2" role="alert">
                                <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i>
                                <span id="quickcards-import-error-msg"></span>
                            </div>

                            <!-- File Preview Details -->
                            <div id="quickcards-import-preview" class="card bg-light border-0 p-3 mb-3 d-none">
                                <h6 class="fw-bold mb-2 text-primary">
                                    <i class="fa fa-info-circle me-1" aria-hidden="true"></i>{{#str}} deckpreview, block_quickcards {{/str}}
                                </h6>
                                <div class="mb-2 quickcards-import-preview-name-row">
                                    <strong>{{#str}} deckname, block_quickcards {{/str}}:</strong>
                                    <span id="quickcards-import-preview-name" class="text-dark"></span>
                                </div>
                                <div class="mb-2">
                                    <strong>{{#str}} cards, block_quickcards {{/str}}:</strong>
                                    <span id="quickcards-import-preview-count" class="badge bg-secondary ms-1"></span>
                                </div>

                                <!-- Course selection (only when creating new deck) -->
                                {{#hascourses}}
                                    <div class="mt-2 pt-2 border-top quickcards-import-course-wrap" id="quickcards-import-json-course-wrap">
                                        <label for="quickcards-import-course-select" class="form-label small fw-bold mb-1">
                                            {{#str}} coursedeck, block_quickcards {{/str}}
                                        </label>
                                        <select id="quickcards-import-course-select" class="form-select form-select-sm">
                                            <option value="0">{{#str}} generaldeck, block_quickcards {{/str}}</option>
                                            {{#courses}}
                                                <option value="{{id}}">{{fullname}}</option>
                                            {{/courses}}
                                        </select>
                                    </div>
                                {{/hascourses}}

                                <!-- Progress Restore Option -->
                                <div id="quickcards-import-progress-wrapper" class="form-check mt-3 pt-2 border-top d-none">
                                    <input class="form-check-input" type="checkbox" id="quickcards-import-restore-progress">
                                    <label class="form-check-label fw-bold" for="quickcards-import-restore-progress">
                                        {{#str}} restoreprogress, block_quickcards {{/str}}
                                    </label>
                                    <div class="form-text small text-muted">
                                        {{#str}} restoreprogress_help, block_quickcards {{/str}}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel, block_quickcards {{/str}}</button>
                            <button type="submit" class="btn btn-primary" id="quickcards-import-submit-btn" disabled>
                                <i class="fa fa-upload me-1" aria-hidden="true"></i> {{#str}} importdeck, block_quickcards {{/str}}
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Tab 2: CSV / Anki / Quizlet Import -->
                <div class="tab-pane fade" id="quickcards-import-tab-csv" role="tabpanel" aria-labelledby="quickcards-tab-csv-btn">
                    <form id="quickcards-import-csv-form">
                        <div class="modal-body">
                            <!-- Locked target banner (when importing directly into a deck) -->
                            <div class="alert alert-info py-2 px-3 mb-3 d-none quickcards-import-target-banner" role="status">
                                <i class="fa fa-folder-open me-2" aria-hidden="true"></i>
                                <span class="quickcards-import-target-name"></span>
                            </div>

                            <!-- Destination choice (when opened globally) -->
                            {{#hasuserdecks}}
                            <div class="mb-3 quickcards-import-dest-choice" id="quickcards-import-csv-dest-choice">
                                <label class="form-label fw-bold">{{#str}} importdestination, block_quickcards {{/str}}</label>
                                <div class="d-flex gap-3 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-csv-dest" id="quickcards-import-csv-dest-new" value="new" checked>
                                        <label class="form-check-label" for="quickcards-import-csv-dest-new">{{#str}} importnewdeck, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-csv-dest" id="quickcards-import-csv-dest-existing" value="existing">
                                        <label class="form-check-label" for="quickcards-import-csv-dest-existing">{{#str}} importexistingdeck, block_quickcards {{/str}}</label>
                                    </div>
                                </div>
                                <div class="quickcards-import-existing-select-wrap d-none" id="quickcards-import-csv-existing-select-wrap">
                                    <select class="form-select form-select-sm" id="quickcards-import-csv-deck-select">
                                        <option value="0">{{#str}} selecttargetdeck, block_quickcards {{/str}}</option>
                                        {{#userdecks}}
                                            <option value="{{id}}">{{name}}</option>
                                        {{/userdecks}}
                                    </select>
                                </div>
                            </div>
                            {{/hasuserdecks}}

                            <!-- Duplicate options (for existing deck) -->
                            <div class="p-2 border rounded bg-light mb-3 d-none quickcards-import-duplicate-wrap" id="quickcards-import-csv-duplicate-wrap">
                                <label class="form-label small fw-bold mb-1">
                                    <i class="fa fa-clone text-secondary me-1" aria-hidden="true"></i>{{#str}} duplicateaction, block_quickcards {{/str}}
                                </label>
                                <div class="form-text small text-muted mb-2">{{#str}} duplicateaction_help, block_quickcards {{/str}}</div>
                                <div class="d-flex flex-column gap-1 small">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-csv-dup" id="quickcards-import-csv-dup-skip" value="skip" checked>
                                        <label class="form-check-label" for="quickcards-import-csv-dup-skip">{{#str}} duplicateskip, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-csv-dup" id="quickcards-import-csv-dup-update" value="update">
                                        <label class="form-check-label" for="quickcards-import-csv-dup-update">{{#str}} duplicateupdate, block_quickcards {{/str}}</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="quickcards-import-csv-dup" id="quickcards-import-csv-dup-allow" value="allow">
                                        <label class="form-check-label" for="quickcards-import-csv-dup-allow">{{#str}} duplicateallow, block_quickcards {{/str}}</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-7" id="quickcards-import-csv-name-wrap">
                                    <label for="quickcards-import-csv-name" class="form-label fw-bold">
                                        {{#str}} deckname, block_quickcards {{/str}} <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="quickcards-import-csv-name" class="form-control" placeholder="e.g. English Vocabulary">
                                </div>
                                <div class="col-md-5" id="quickcards-import-csv-delimiter-wrap">
                                    <label for="quickcards-import-csv-delimiter" class="form-label fw-bold">
                                        {{#str}} delimiter, block_quickcards {{/str}}
                                    </label>
                                    <select id="quickcards-import-csv-delimiter" class="form-select">
                                        <option value="auto">{{#str}} delimiter_auto, block_quickcards {{/str}}</option>
                                        <option value="tab">{{#str}} delimiter_tab, block_quickcards {{/str}}</option>
                                        <option value="semicolon">{{#str}} delimiter_semicolon, block_quickcards {{/str}}</option>
                                        <option value="comma">{{#str}} delimiter_comma, block_quickcards {{/str}}</option>
                                    </select>
                                </div>
                            </div>

                            {{#hascourses}}
                                <div class="mb-3 quickcards-import-course-wrap" id="quickcards-import-csv-course-wrap">
                                    <label for="quickcards-import-csv-course" class="form-label fw-bold">
                                        {{#str}} coursedeck, block_quickcards {{/str}}
                                    </label>
                                    <select id="quickcards-import-csv-course" class="form-select">
                                        <option value="0">{{#str}} generaldeck, block_quickcards {{/str}}</option>
                                        {{#courses}}
                                            <option value="{{id}}">{{fullname}}</option>
                                        {{/courses}}
                                    </select>
                                </div>
                            {{/hascourses}}

                            <div class="mb-3">
                                <label for="quickcards-import-csv-file" class="form-label fw-bold">
                                    {{#str}} selectcsvfile, block_quickcards {{/str}}
                                </label>
                                <input type="file" id="quickcards-import-csv-file" class="form-control form-control-sm" accept=".csv,.tsv,.txt,text/csv,text/plain">
                                <div class="form-text text-muted">{{#str}} selectcsvfile_help, block_quickcards {{/str}}</div>
                            </div>

                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label for="quickcards-import-csv-text" class="form-label fw-bold mb-0">
                                        {{#str}} pastecsvdata, block_quickcards {{/str}} <span class="text-danger">*</span>
                                    </label>
                                    <span id="quickcards-import-csv-count" class="badge bg-info text-dark d-none"></span>
                                </div>
                                <textarea id="quickcards-import-csv-text" class="form-control font-monospace small" rows="6" required placeholder="{{#str}} pastecsvdata_placeholder, block_quickcards {{/str}}"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel, block_quickcards {{/str}}</button>
                            <button type="submit" class="btn btn-primary" id="quickcards-import-csv-submit-btn" disabled>
                                <i class="fa fa-upload me-1" aria-hidden="true"></i> {{#str}} importdeck, block_quickcards {{/str}}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
